# Server
PORT=5000
NODE_ENV=development

# Database (used by model/db.js — falls back to config/config.json if unset)
# Never commit real host/passwords — copy to .env (gitignored) for local/hosting.
DBHOST=127.0.0.1
DBUSER=your-db-user
DBPASS=your-db-password
DBNAME=your-db-name

# Auth — use long random secrets in real .env; rotate before hosting
JWT_SECRET=your-jwt-secret-here
JWT_SECRET_INSTITUTE=your-institute-jwt-secret-here

# Google OAuth (optional — server starts without these)
GOOGLE_ID=
GOOGLE_SECRET=

# OpenAI (optional — chat AI falls back without this)
OPENAI_API_KEY=

# Frontend URL (password reset emails)
FRONTEND_URL=http://localhost:3000

# Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

